{
  "name": "signet-pdf",
  "version": "1.1.1",
  "description": "Private, open-source PDF signing app for desktop and mobile",
  "scripts": {
    "dev": "node scripts/copy-pdfjs.mjs && vite",
    "build": "node scripts/copy-pdfjs.mjs && vite build && node scripts/build-sw.mjs",
    "preview": "vite preview --port 4173",
    "test": "node tests/run-all.mjs"
  },
  "license": "MIT",
  "dependencies": {
    "@cantoo/pdf-lib": "^2.11.1",
    "@fontsource/atkinson-hyperlegible": "^5.3.0",
    "@fontsource/caveat": "^5.3.0",
    "@fontsource/dancing-script": "^5.3.0",
    "@fontsource/homemade-apple": "^5.3.0",
    "@fontsource/mrs-saint-delafield": "^5.3.0",
    "node-forge": "^1.4.0",
    "pdfjs-dist": "^6.4.299"
  },
  "devDependencies": {
    "playwright": "^1.56.0",
    "vite": "^8.3.4"
  },
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20"
  }
}
